# 复制本文件为项目根目录的 .env 后按需修改（.env 已被 .gitignore 忽略，切勿提交到 Git）
# cp deploy/env.example .env

# 站点访问地址：
# - 无域名、直接通过服务器公网 IP 访问时保持 :80
# - 已绑定域名并完成解析（中国大陆节点需完成 ICP 备案）时改为你的域名，例如 shishi.example.com，Caddy 会自动申请免费 HTTPS 证书
SHISHI_SITE_ADDRESS=:80

# SQLite 日志模式：Linux 生产环境保持 WAL，防止崩溃或断电损库
SHISHI_SQLITE_JOURNAL_MODE=WAL

# 注册控制：
# - 设为 false 可完全关闭公开注册（仅允许已有账号登录）
# - 保持 true 并设置 SHISHI_INVITE_CODE 时，新用户必须输入正确邀请码才能注册
SHISHI_ALLOW_REGISTER=true
SHISHI_INVITE_CODE=

# SSRF 防护：默认 false，禁止 AI 接口地址指向本机、内网或云主机元数据地址（169.254.169.254）
SHISHI_ALLOW_PRIVATE_AI_URL=false

# 可选：全站默认 AI 配置（未设置时由各账号在页面内自行配置）
SHISHI_AI_BASE_URL=
SHISHI_AI_MODEL=
SHISHI_AI_API_KEY=

# 可选：默认小红书 Cookie（通常建议各账号在页面内自行维护）
XHS_COOKIE=
